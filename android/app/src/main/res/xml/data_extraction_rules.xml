<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ни облачная копия, ни перенос на новый телефон не берут файлы приложения.
     Зашифрованная база без ключа из Keystore этого устройства нечитаема; данные переносятся копией из приложения. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
