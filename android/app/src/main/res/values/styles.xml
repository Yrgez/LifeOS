<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Приложение всегда тёмное. Тема — из AppCompat: её требует системное окно биометрии (local_auth). -->
    <!-- Окно при запуске процесса: чёрный фон, без белой вспышки до первого кадра Flutter -->
    <style name="LaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Окно под интерфейсом Flutter -->
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
